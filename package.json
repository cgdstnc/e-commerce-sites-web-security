{
  "name": "ecommerce-security-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web security measurement of Turkish e-commerce sites: the full pipeline (TypeScript)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "verify": "node src/main.ts --verify",
